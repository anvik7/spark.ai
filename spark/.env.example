# --- Spark config. Copy to .env. App runs fully with NONE of these set. ---

# Database. SQLite for local dev; swap to Postgres for production:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/spark
DATABASE_URL=sqlite:///./spark.db

# Session signing. MUST be set in production (random long string).
JWT_SECRET=

# --- AI tagging / synthesis -------------------------------------------------
# LLM_PROVIDER: mock | gemini | groq | anthropic
LLM_PROVIDER=mock
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# LLM_MODEL=                # optional override

# --- Regional voice notes ---------------------------------------------------
# TRANSCRIBER: mock | bhashini | whisper
TRANSCRIBER=mock
BHASHINI_API_KEY=

# --- Billing (Razorpay) -----------------------------------------------------
# Set RAZORPAY_MODE=live for production payments. "test" uses test keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test
# --- Plan limits ------------------------------------------------------------
FREE_CARD_LIMIT=100

# --- Object Storage (Local Filesystem / Cloudflare R2 / AWS S3) -------------
# STORAGE_BACKEND: local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=               # Optional override for local uploads dir (default: spark/uploads)

# Production Cloudflare R2 / S3 settings (required if STORAGE_BACKEND=s3):
S3_ENDPOINT_URL=                 # e.g. https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=                # R2 / AWS Access Key ID
S3_SECRET_ACCESS_KEY=            # R2 / AWS Secret Access Key
S3_BUCKET=                       # e.g. spark-media-prod (must be a private bucket)
S3_REGION=auto                   # "auto" for Cloudflare R2, or e.g. "us-east-1" for AWS
